# API mode (default)
MUAPI_API_KEY=your_muapi_key_here

# Local mode (--mode local)
LLM_PROVIDER=openai           # openai | gemini | ollama | nim
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

# Ollama (fully local, no API key needed)
# Make sure Ollama is running: ollama serve
# Pull the model first: ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_NUM_CTX=16384

# NVIDIA NIM (hosted catalog or self-hosted container)
# Get a key at https://build.nvidia.com for hosted
# Self-hosted: point NIM_BASE_URL at http://localhost:8000/v1
NIM_API_KEY=nvapi-your_key_here
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.1-8b-instruct

LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=auto
LOCAL_OUTPUT_DIR=output

# YouTube anti-bot workaround (local mode only).
# If downloads fail with "Sign in to confirm you're not a bot", pick ONE:
#  1) Read cookies straight from your browser -- CLOSE the browser fully first.
#     Examples: edge, chrome, firefox, brave
# YTDLP_COOKIES_FROM_BROWSER=edge
#  2) Or point at an exported cookies.txt (extension "Get cookies.txt LOCALLY").
# YTDLP_COOKIES=C:\path\to\cookies.txt
#  3) Or skip YouTube download entirely: save the video yourself and use the
#     "Local file" picker in the GUI.
# YTDLP_COOKIES_FROM_BROWSER=
# YTDLP_COOKIES=

# Burned-in subtitles (local mode, opt-in). Word timestamps are requested from
# faster-whisper only while this is on; the .ass sidecar is written next to each
# draft clip and burned in at finalize time.
CAPTIONS_ENABLED=0               # 1 = on
CAPTION_STYLE=karaoke            # karaoke (пер-word highlight) | classic
# CAPTION_FONT=Arial
# CAPTION_FONT_SIZE=72
# CAPTION_MAX_WORDS=4            # words per caption line
# CAPTION_MARGIN_V=150           # bottom margin on the 1080x1920 canvas
# Colors as RRGGBB hex (ASS channel order is handled internally):
# CAPTION_TEXT_COLOR=FFFFFF
# CAPTION_ACTIVE_COLOR=FFD700    # karaoke highlight of the current word

# Face tracking during the vertical reframe (local mode). On by default;
# set 0 for a static ffmpeg centre crop.
# FACE_TRACK_ENABLED=1

# Thumbnails (review card «🖼 Обложка» / POST /api/shorts/thumbnail)
# THUMB_AT_PERCENT=12        # frame position as % of duration (clamped 1..90)
# THUMB_TITLE=               # default overlay text when the request sends none

# ---------------------------------------------------------------------------
# Effects (local mode). All of these are also settable per-run from the GUI;
# they are listed here so you can change the *defaults* permanently.
# ---------------------------------------------------------------------------

# Silence cutting inside each clip (before reframe).
SILENCE_CUT=1                  # 0 = keep pauses
# SILENCE_NOISE_DB=-35         # threshold, dB (lower = more aggressive)
# SILENCE_MIN_DUR=0.45         # min pause length to cut, seconds
# SILENCE_KEEP_EXTRA=0.15      # padding around speech, seconds

# Blurred side/top bars when the target aspect is taller than the source
# (e.g. 16:9 source -> 9:16 canvas). Bars show a blurred+dimmed copy of the
# video itself instead of solid black.
BLUR_BARS=1                    # 0 = plain black bars
# BLURPAD_FG_SCALE=100         # foreground fit, % of canvas width (50..100)
# BLURPAD_SIGMA=18             # background blur strength (3..60)
# BLURPAD_DIM=0.06             # background darkening 0..0.7

# Watermark overlay (TikTok-style). NOTE: the repo does NOT ship an overlay
# file; put your own overlay video at ./TIKTOK1.mov (1080x1920 portrait) or
# turn this off, otherwise the step is silently skipped.
OVERLAY_ENABLED=1              # 0 = never render a watermark
# USE_OVERLAY_OPENCV=1         # 1 = OpenCV compositor, 0 = ffmpeg fallback
# OVERLAY_POSITION=br          # tl tc tr ml mc mr bl bc br
# OVERLAY_SCALE=1.0            # relative scale of the overlay
# OVERLAY_MARGIN=20            # px from canvas edge
# OVERLAY_X= / OVERLAY_Y=      # free position 0..1 (overrides OVERLAY_POSITION)

# Background music (local mode). Music file can also be uploaded from the GUI.
MUSIC_ENABLED=0
# MUSIC_FILE=C:\path\to\track.mp3
# MUSIC_VOLUME=40              # 0..100

# Caption position on the vertical canvas.
# CAPTION_POSITION=bottom      # bottom | center | top
# CAPTION_OUTLINE_COLOR=000000
# CAPTION_SHADOW_COLOR=80000000

# ffmpeg encoder override (normally auto-detected).
# FFMPEG_ENCODER=              # e.g. libx264 to force CPU encoding
# FORCE_CPU_FFMPEG=1           # 1 = never use GPU encoders

# ---------------------------------------------------------------------------
# GUI server (start_gui / python app.py)
# ---------------------------------------------------------------------------
# Bind address. Default 0.0.0.0 (reachable from your LAN).
# Set GUI_HOST=127.0.0.1 to allow only this machine.
# GUI_HOST=0.0.0.0
# GUI_PORT=5000
# Set a token to protect /api/* when the GUI is reachable from the network.
# When set, every API call must carry it ("?token=" or Authorization: Bearer).
# GUI_TOKEN=

# Local LLM HTTP timeout (seconds). Ollama/NIM on big models can need a while.
# LOCAL_LLM_TIMEOUT=600

# faster-whisper VAD filter (experimental, tr.im у silent-области транскрипта)
# LOCAL_WHISPER_VAD_FILTER=0
# LOCAL_WHISPER_VAD_PARAMETERS={"min_silence_duration_ms": 500}
